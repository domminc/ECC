# 복사: cp deploy/autopilot.env.example ~/.config/naver-ads-autopilot.env && chmod 600 ~/.config/naver-ads-autopilot.env
# 이 파일은 저장소 밖에 두세요. 값은 절대 커밋하지 않습니다.

# 네이버 검색광고 API (광고관리시스템 > 도구 > API 사용 관리)
NAVER_SA_CUSTOMER_A=
NAVER_SA_API_KEY_A=
NAVER_SA_SECRET_A=

# 알림 (둘 다 쓰거나 하나만 써도 됩니다)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
